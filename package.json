{
  "name": "dsh-plugin-slashx-gateway",
  "version": "0.1.0",
  "description": "DeepSeek Harness host bundle that implements slashx.request.v1 and slashx.response.v1",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "slashx",
    "agent",
    "gateway",
    "plugin"
  ],
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./protocol": "./lib/protocol.js"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "eslint --config ../../eslint.packages.config.mjs .",
    "test": "node --test tests/*.test.js",
    "check": "node --check index.js && node --check lib/*.js",
    "prepack": "npm run check && npm test"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.0-rc.6 <0.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/superslash-rico/dsh-plugin-slashx-gateway.git"
  },
  "bugs": {
    "url": "https://github.com/superslash-rico/dsh-plugin-slashx-gateway/issues"
  },
  "homepage": "https://github.com/superslash-rico/dsh-plugin-slashx-gateway#readme"
}
